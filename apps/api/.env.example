# ---------- Core ----------
PORT=4000
NODE_ENV=development
# Public URL of this API (used for webhooks, OAuth redirects and media links)
API_URL=http://localhost:4000
# Public URL of the web app (used for redirects after OAuth / checkout)
WEB_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (defaults to WEB_URL)
CORS_ORIGINS=http://localhost:3000
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# ---------- Data ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatnova
# Optional locally (jobs then run in-process). Required in production for durable queues.
REDIS_URL=
# Set to "false" when running a separate worker service (npm run start:worker)
RUN_WORKER=true
# Where uploaded / downloaded media is stored. On Railway mount a volume and point this at it.
UPLOAD_DIR=./uploads
# Emails (comma-separated) that can open /admin
SUPER_ADMIN_EMAILS=you@example.com

# ---------- Meta (developers.facebook.com) ----------
META_APP_ID=
META_APP_SECRET=
# Any string; enter the same value in the Meta app webhook settings
META_VERIFY_TOKEN=chatnova-verify
META_GRAPH_VERSION=v21.0
# Messages per second when sending broadcasts
BROADCAST_RATE_PER_SECOND=20

# ---------- Google ----------
# OAuth client ID for "Sign in with Google"
GOOGLE_CLIENT_ID=
# Service account JSON (single line) for the Google Sheets integration
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------- Billing ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
